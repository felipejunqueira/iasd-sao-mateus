{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/equipe", "dest": "/equipe.html" },
    { "src": "/adolescentes", "status": 302, "headers": { "Location": "https://felipejunqueira.github.io/ChurchRankingApp/" } },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
